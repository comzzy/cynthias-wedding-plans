# ElevenLabs: speech-to-text (Scribe) + text-to-speech. Server-side only.
ELEVENLABS_API_KEY=
# Optional overrides
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # "Sarah", warm and reassuring
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5     # cheapest/fastest; eleven_multilingual_v2 for richer voice
# ELEVENLABS_STT_MODEL=scribe_v1

# Open-weight LLM through any OpenAI-compatible API.
# Option A (default): Groq hosting OpenAI's open-weight gpt-oss (Apache 2.0)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=            # or set GROQ_API_KEY
LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Option B: fully local on a laptop with Ollama (no key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma3:4b          # gemma3:1b works on small machines

# Option C: OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemma-3-27b-it

# Shared storage for RSVPs + guestbook (Vercel Blob, private store). Added automatically when you connect a Blob store.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
# Cynthia's key for /rsvp/list?key=..., the CSV export and hiding wishes. Required on Vercel.
RSVP_HOST_KEY=
# DATA_DIR=.data
